         mean_q = (max_q + min_q) / 2
         # idx_anchor = np.argmin(np.abs(valid_q_main_joint - q_0[joint]))
         mid_idx = np.argmin(np.abs(valid_q_main_joint - mean_q))
@@ -2407,6 +2427,53 @@ def build_lookup_dict_with_fp_and_phi(
     theta_offsets = valid_theta - anchor
     theta_offsets = (theta_offsets + np.pi) % (2 * np.pi) - np.pi
 
+    # MORPHOHAND PATCH: restrict the calibration to the MONOTONIC branch of theta(q) around the
+    # anchor.
+    #
+    # Everything below assumes theta(q) is monotonic across the valid range: `min_offset` and
+    # `max_offset` are read off the two ENDPOINTS of the q sweep, and `q_list` is then built by
+    # linearly interpolating q over (min_offset -> zero_q -> max_offset). That holds for the
+    # shipped hands. It fails for a finger whose fingertip passes near the sphere pole, where the
+    # azimuth wraps: theta(q) doubles back, BOTH sweep endpoints land on the far side of the
+    # branch cut, and the recorded range comes out narrow and entirely one-signed --
+    # m05 slots 0/1 = [-2.887, -2.718], H06_04 slot 4 = [-2.948, -2.774]. The Isaac env clamps
+    # each slot's lateral action into that range, so a range excluding 0 pins the joint at a
+    # large fixed angle and the finger can never return to its neutral pose.
+    #
+    # Narrowing to the contiguous monotonic neighbourhood of the anchor makes the assumption true
+    # rather than merely assumed: inside it theta <-> q is single-branch and invertible, which is
+    # what the lookup needs. It costs nominal range on the degenerate fingers, which is honest --
+    # that range was never usable, it was an artifact of reading across a branch cut.
+    #
+    # Set UHAS_MONOTONIC_BRANCH=0 to restore upstream behaviour.
+    if os.environ.get("UHAS_MONOTONIC_BRANCH", "1") == "1" and len(theta_offsets) > 2:
+        _d = np.diff(theta_offsets)
+        _a = int(np.clip(idx_anchor, 0, len(_d) - 1))
+        _sign = np.sign(_d[_a]) if np.sign(_d[_a]) != 0 else 1.0
+        # A wrap shows up as a step of order 2*pi; break on it explicitly, since a wrap can share
+        # the sign of the surrounding trend and would otherwise slip through the sign test.
+        _jump = np.pi / 2
+
+        _lo = _a
+        while _lo > 0 and np.sign(_d[_lo - 1]) == _sign and abs(_d[_lo - 1]) < _jump:
+            _lo -= 1
+        _hi = _a + 1
+        while _hi < len(_d) and np.sign(_d[_hi]) == _sign and abs(_d[_hi]) < _jump:
+            _hi += 1
+
+        if _hi - _lo + 1 < len(theta_offsets):
+            print(f"[MORPHOHAND] {joint}: monotonic branch {_lo}..{_hi} of 0..{len(theta_offsets)-1} "
+                  f"(theta range {theta_offsets[_lo]:+.3f}..{theta_offsets[_hi]:+.3f} rad)")
+        _sl = slice(_lo, _hi + 1)
+        valid_q_main_joint = valid_q_main_joint[_sl]
+        valid_theta = valid_theta[_sl]
+        valid_q_all_joints = valid_q_all_joints[_sl]
+        valid_phi = valid_phi[_sl]
+        theta_offsets = theta_offsets[_sl]
+        idx_anchor = int(np.argmin(np.abs(theta_offsets)))
+        q_anchor = valid_q_main_joint[idx_anchor]
+        min_anchor_distance = valid_theta[idx_anchor] - anchor
+
     # Find indices for min and max q values
     min_idx = np.argmin(valid_q_main_joint)
     max_idx = np.argmax(valid_q_main_joint)
