@@ -0,0 +1,120 @@
+# MORPHOHAND PATCH: build a UHAS gripper ArticulationCfg from a built-hand directory.
+#
+# A "built hand" is what `scripts/uhas_build_hand.py` + `scripts/uhas_urdf_to_usd.py` leave behind:
+#
+#   <root>/<name>/
+#       <name>.urdf         exported from MJCF, morphology baked to fixed geometry
+#       config.json         {"opened_dofs": {...}} -- the open pose the sphere was fitted at
+#       sphere_cik.json     the UHAS representation (read by multi_env_cfg, not by us)
+#       meshes/             STLs
+#       usd/<name>.usd      URDF -> USD, converted headless
+#
+# The robot tag is `morpho_<name>`; `<root>` comes from the UHAS_MORPHO_ROOT environment variable.
+import json
+import os
+
+import isaaclab.sim as sim_utils
+from isaaclab.actuators.actuator_cfg import ImplicitActuatorCfg
+from isaaclab.assets.articulation import ArticulationCfg
+
+MORPHO_ROOT = os.environ.get("UHAS_MORPHO_ROOT", "")
+
+TAG_PREFIX = "morpho_"
+
+
+def list_morphohands(root: str | None = None) -> list[str]:
+    """Names of every built hand under ``root`` that has both a USD and a sphere_cik.json."""
+    root = root or MORPHO_ROOT
+    if not root or not os.path.isdir(root):
+        return []
+    out = []
+    for name in sorted(os.listdir(root)):
+        d = os.path.join(root, name)
+        if os.path.isfile(os.path.join(d, "usd", f"{name}.usd")) and os.path.isfile(
+            os.path.join(d, "sphere_cik.json")
+        ):
+            out.append(name)
+    return out
+
+
+def resolve_morphohand(robot: str, root: str | None = None) -> tuple[str, str, str]:
+    """``morpho_<name>`` -> (hand_dir, usd_path, sphere_cik_path). Raises with a usable message."""
+    root = root or MORPHO_ROOT
+    if not robot.startswith(TAG_PREFIX):
+        raise ValueError(f"{robot!r} is not a MorphoHand tag (expected {TAG_PREFIX}<name>)")
+    name = robot[len(TAG_PREFIX) :]
+    if not root:
+        raise ValueError(
+            f"robot {robot!r} needs UHAS_MORPHO_ROOT set to the directory of built hands"
+        )
+    hand_dir = os.path.join(root, name)
+    usd_path = os.path.join(hand_dir, "usd", f"{name}.usd")
+    cik_path = os.path.join(hand_dir, "sphere_cik.json")
+    for p in (usd_path, cik_path):
+        if not os.path.isfile(p):
+            raise FileNotFoundError(
+                f"{robot}: missing {p}. Built hands under {root}: {list_morphohands(root)}"
+            )
+    return hand_dir, usd_path, cik_path
+
+
+def morphohand_cfg(robot: str, root: str | None = None) -> tuple[ArticulationCfg, str]:
+    """Return (ArticulationCfg, sphere_cik path) for ``morpho_<name>``.
+
+    The spawn properties mirror LEAP's (`leap_right.py`) exactly -- gravity off, self-collisions
+    on, 8 position iterations -- so a cross-hand comparison is not silently also a comparison of
+    solver settings. The actuator block here is a placeholder: `multi_env_cfg` replaces
+    ``actuators`` wholesale with the shared `ImplicitActuatorCfg`, which is what makes every hand
+    in a UHAS run share one set of gains.
+    """
+    hand_dir, usd_path, cik_path = resolve_morphohand(robot, root)
+
+    with open(os.path.join(hand_dir, "config.json")) as f:
+        opened_dofs = json.load(f)["opened_dofs"]
+    # The env overwrites the hand pose at every reset from `q_open_palm` in sphere_cik.json, so
+    # this only sets the spawn pose -- but spawning at the open pose keeps the very first physics
+    # step from starting inside a self-collision.
+    joint_pos = {k: float(v) for k, v in opened_dofs.items()}
+
+    cfg = ArticulationCfg(
+        spawn=sim_utils.UsdFileCfg(
+            usd_path=usd_path,
+            activate_contact_sensors=False,
+            rigid_props=sim_utils.RigidBodyPropertiesCfg(
+                kinematic_enabled=False,
+                disable_gravity=True,
+                retain_accelerations=True,
+                enable_gyroscopic_forces=False,
+                angular_damping=0.01,
+                max_linear_velocity=1000.0,
+                max_angular_velocity=64 / 3.141592653589793 * 180.0,
+                max_depenetration_velocity=1000.0,
+                max_contact_impulse=1e32,
+            ),
+            articulation_props=sim_utils.ArticulationRootPropertiesCfg(
+                enabled_self_collisions=True,
+                solver_position_iteration_count=8,
+                solver_velocity_iteration_count=0,
+                sleep_threshold=0.005,
+                stabilization_threshold=0.0005,
+            ),
+        ),
+        init_state=ArticulationCfg.InitialStateCfg(
+            pos=(0.0, 0.0, 0.0),
+            rot=(1.0, 0.0, 0.0, 0.0),
+            joint_pos=joint_pos,
+        ),
+        actuators={
+            "fingers": ImplicitActuatorCfg(
+                joint_names_expr=[".*"],
+                effort_limit_sim=0.4,
+                stiffness=3.0,
+                damping=0.2,
+                velocity_limit_sim=5.0,
+                friction=0.02,
+                armature=0.00149376,
+            ),
+        },
+        soft_joint_pos_limit_factor=1.0,
+    )
+    return cfg, cik_path
