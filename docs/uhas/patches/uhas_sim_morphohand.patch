+
+    def compare_versions(v1: str, v2: str) -> int:
+        parts1 = list(map(int, v1.split(".")))
+        parts2 = list(map(int, v2.split(".")))
+        length = max(len(parts1), len(parts2))
+        parts1 += [0] * (length - len(parts1))
