+# MORPHOHAND PATCH: data-driven hand family.
+#
+# The five shipped grippers each get a hand-written `<hand>_right.py` with a hard-coded USD path
+# and a hard-coded joint dict, plus a branch in `multi_env_cfg.py`. That is fine for five fixed
+# hands and wrong for a morphology sweep, where the whole point is that the hand is a free
+# variable and there are as many of them as we care to sample.
+#
+# This module builds the `ArticulationCfg` from the built-hand directory instead, so adding a
+# morphology is `uhas_build_hand.py` + `uhas_urdf_to_usd.py` and nothing else.
+from .morphohand import MORPHO_ROOT, list_morphohands, morphohand_cfg, resolve_morphohand
+
+__all__ = ["MORPHO_ROOT", "list_morphohands", "morphohand_cfg", "resolve_morphohand"]
