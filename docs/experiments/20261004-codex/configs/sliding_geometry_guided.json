{
  "defaults": {
    "engine_version": "3.14.0",
    "duration": 1.3,
    "timestep": 0.00005,
    "relaxation": 0.03,
    "mode": "dynamic",
    "scenario": "guided_slip",
    "mass_scale": 1.0,
    "inertia_scale": 1.0,
    "tangent_fixture_damping": 5.0,
    "mapping_policy": "runtime_selected_direct",
    "diagexact": true,
    "impedance_override": 0.0001,
    "impratio": 10000.0,
    "tangent_damping_ratio": 10.0,
    "contact_log_stride": 50
  },
  "groups": [
    {
      "name": "plane_direction",
      "fixed": {"geometry": "plane", "spacing_mm": 1.0},
      "grid": {"slide_axis": ["x", "y"]}
    },
    {
      "name": "cylinder_curvature",
      "fixed": {"geometry": "cylinder", "spacing_mm": 1.0},
      "grid": {"object_radius_mm": [6.25, 12.5, 25.0, 50.0], "slide_axis": ["x", "y"]}
    },
    {
      "name": "sphere_curvature",
      "fixed": {"geometry": "sphere", "spacing_mm": 1.0, "slide_axis": "y"},
      "grid": {"object_radius_mm": [12.5, 25.0]}
    },
    {
      "name": "dense_curvature",
      "fixed": {"geometry": "cylinder", "spacing_mm": 0.5, "object_radius_mm": 12.5},
      "grid": {"slide_axis": ["x", "y"]}
    },
    {
      "name": "dense_sphere",
      "fixed": {"geometry": "sphere", "spacing_mm": 0.5, "object_radius_mm": 12.5, "slide_axis": "y"},
      "grid": {}
    },
    {
      "name": "sample_phase",
      "fixed": {"geometry": "cylinder", "spacing_mm": 1.0, "object_radius_mm": 12.5, "slide_axis": "y"},
      "grid": {"phase_degrees": [30.0, 60.0]}
    }
  ]
}
